# Copy to .env and fill in before `docker compose up -d`.

# PostgreSQL
POSTGRES_DB=npsync
POSTGRES_USER=npsync
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# 64 hex chars (32 bytes), e.g. `openssl rand -hex 32`. Signs access tokens.
TOKEN_SIGNING_KEY=

# Public URL of this server (used in device-pairing payloads and docs)
BASE_URL=https://sync.myserver.com

# Blob storage: fs (built-in volume) or s3 (S3/R2/MinIO)
BLOB_BACKEND=fs
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Google SSO (optional). Leave both blank to keep email/password only.
# Create a Web application OAuth client in Google Cloud Console.
# The redirect URI must be ${BASE_URL}/auth/google/callback unless you set
# GOOGLE_REDIRECT_URI. Do not commit real values. See docs/self-hosting.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Limits (server-side, configurable)
MAX_FILE_BYTES=104857600
MAX_BATCH_BYTES=262144000
MAX_DEVICES=10
VERSION_RETENTION=30
REGISTRATION_OPEN=true
