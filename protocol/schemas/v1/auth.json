{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://npsync.dev/schemas/v1/auth.json",
  "title": "NPSync auth requests/responses (protocol v1)",
  "definitions": {
    "register_request": {
      "type": "object",
      "required": ["email", "password", "device_name"],
      "properties": {
        "email":       { "type": "string", "format": "email", "maxLength": 254 },
        "password":    { "type": "string", "minLength": 10, "maxLength": 128 },
        "device_name": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "additionalProperties": false
    },
    "login_request": {
      "type": "object",
      "required": ["email", "password", "device_name"],
      "properties": {
        "email":       { "type": "string", "format": "email" },
        "password":    { "type": "string", "minLength": 1, "maxLength": 128 },
        "device_name": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "additionalProperties": false
    },
    "google_start_request": {
      "type": "object",
      "properties": {
        "device_name": { "type": "string", "maxLength": 64 }
      },
      "additionalProperties": false
    },
    "google_start_response": {
      "type": "object",
      "required": ["authorization_url", "state", "poll_secret", "expires_in"],
      "properties": {
        "authorization_url": { "type": "string", "format": "uri" },
        "state":            { "type": "string", "minLength": 32 },
        "poll_secret":      { "type": "string", "minLength": 32 },
        "expires_in":       { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "google_poll_request": {
      "type": "object",
      "required": ["state", "poll_secret"],
      "properties": {
        "state":       { "type": "string", "minLength": 32 },
        "poll_secret": { "type": "string", "minLength": 32 }
      },
      "additionalProperties": false
    },
    "google_poll_pending": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "const": "pending" }
      },
      "additionalProperties": false
    },
    "refresh_request": {
      "type": "object",
      "required": ["refresh_token"],
      "properties": { "refresh_token": { "type": "string", "minLength": 32 } },
      "additionalProperties": false
    },
    "token_response": {
      "type": "object",
      "required": ["account_id", "device_id", "access_token",
                   "access_expires_at", "refresh_token", "server_protocols"],
      "properties": {
        "account_id":        { "type": "string", "format": "uuid" },
        "device_id":         { "type": "string", "format": "uuid" },
        "access_token":      { "type": "string" },
        "access_expires_at": { "type": "string", "format": "date-time" },
        "refresh_token":     { "type": "string" },
        "server_protocols":  { "type": "array", "items": { "type": "integer" } }
      },
      "additionalProperties": false
    }
  }
}
