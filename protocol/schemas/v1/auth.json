{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://npsync.dev/schemas/v1/auth.json",
  "title": "NPSync auth requests/responses (protocol v1)",
  "definitions": {
    "register_request": {
      "type": "object",
      "required": ["email", "password", "device_name"],
      "properties": {
        "email":       { "type": "string", "format": "email", "maxLength": 254 },
        "password":    { "type": "string", "minLength": 10, "maxLength": 128 },
        "device_name": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "additionalProperties": false
    },
    "login_request": {
      "type": "object",
      "required": ["email", "password", "device_name"],
      "properties": {
        "email":       { "type": "string", "format": "email" },
        "password":    { "type": "string", "minLength": 1, "maxLength": 128 },
        "device_name": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "additionalProperties": false
    },
    "refresh_request": {
      "type": "object",
      "required": ["refresh_token"],
      "properties": { "refresh_token": { "type": "string", "minLength": 32 } },
      "additionalProperties": false
    },
    "token_response": {
      "type": "object",
      "required": ["account_id", "device_id", "access_token",
                   "access_expires_at", "refresh_token", "server_protocols"],
      "properties": {
        "account_id":        { "type": "string", "format": "uuid" },
        "device_id":         { "type": "string", "format": "uuid" },
        "access_token":      { "type": "string" },
        "access_expires_at": { "type": "string", "format": "date-time" },
        "refresh_token":     { "type": "string" },
        "server_protocols":  { "type": "array", "items": { "type": "integer" } }
      },
      "additionalProperties": false
    }
  }
}
